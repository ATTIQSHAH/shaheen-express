---
import siteData from '../content/site.json';

const stats = siteData.stats;
---

<section class="relative z-10 -mt-10 sm:-mt-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Company Statistics">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
    {stats.map((stat, idx) => (
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xl shadow-slate-900/5 border border-slate-100 flex items-center gap-5 hover:-translate-y-1 transition-transform duration-200">
        <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-400/20 text-amber-500 flex items-center justify-center shrink-0">
          {idx === 0 && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          )}
          {idx === 1 && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
            </svg>
          )}
          {idx === 2 && (
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          )}
        </div>
        <div>
          <div class="flex items-baseline gap-0.5">
            <span class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-['Plus_Jakarta_Sans'] tabular-nums">
              {stat.prefix}{stat.value}{stat.suffix}
            </span>
          </div>
          <span class="text-sm font-bold text-slate-700 tracking-wide block mt-0.5 uppercase">
            {stat.label}
          </span>
          <span class="text-xs text-slate-600 font-medium block mt-0.5">
            {stat.description}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
