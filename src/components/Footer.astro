---
import siteData from '../content/site.json';

const currentYear = 2026;
---

<footer class="bg-[#070C1B] text-slate-300 border-t border-slate-800 pt-16 pb-24 md:pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & About -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-white p-1 flex items-center justify-center shadow-md">
            <img
              src="/images/logo.webp"
              alt="Shaheen Express Emblem"
              width="44"
              height="44"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
          <div>
            <span class="text-xl font-bold text-white uppercase tracking-wider block">Shaheen Express</span>
            <span class="text-xs text-amber-400 font-semibold tracking-wide">ESTABLISHED 2014</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {siteData.footer_about}
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Quick Links
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li>
            <a href="/about" class="hover:text-amber-400 transition-colors">About Us</a>
          </li>
          <li>
            <a href="/services" class="hover:text-amber-400 transition-colors">Services & Amenities</a>
          </li>
          <li>
            <a href="/schedule" class="hover:text-amber-400 transition-colors">Bus Schedule & Routes</a>
          </li>
          <li>
            <a href="/fleet" class="hover:text-amber-400 transition-colors">Fleet & Sleeper Gallery</a>
          </li>
          <li>
            <a href="/terminals" class="hover:text-amber-400 transition-colors">Terminals & Offices</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-amber-400 transition-colors">Contact Us</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contact Details (Verbatim) -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Contact Us
        </h3>
        <ul class="space-y-3.5 text-sm">
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-800 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-slate-400">Booking / Support Phone</span>
              <a href={siteData.phone_link} class="text-white hover:text-amber-400 font-semibold tracking-wide text-base">
                {siteData.phone}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-800 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-slate-400">Official Email</span>
              <a href={`mailto:${siteData.email}`} class="text-white hover:text-amber-400 break-all">
                {siteData.email}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-800 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <span class="block text-xs text-slate-400">Terminal & Head Office</span>
              <p class="text-slate-300 leading-snug">
                {siteData.address}
              </p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Col 4: Social & WhatsApp -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          Follow Us On
        </h3>
        <p class="text-xs text-slate-400 mb-4">
          Stay updated with latest announcements, sleeper coach schedules, and travel news.
        </p>
        <div class="flex items-center gap-3 mb-6">
          <a
            href={siteData.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-blue-600 text-white flex items-center justify-center transition-all"
            aria-label="Shaheen Express Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
          <a
            href={siteData.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-slate-800 hover:bg-red-600 text-white flex items-center justify-center transition-all"
            aria-label="Shaheen Express YouTube"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        </div>
        <a
          href={siteData.whatsapp_link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors w-full justify-center shadow-lg shadow-emerald-700/20"
        >
          WhatsApp Booking Line
        </a>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {currentYear} {siteData.name}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/schedule" class="hover:text-slate-300">Routes & Timings</a>
        <a href="/terminals" class="hover:text-slate-300">Terminals</a>
        <a href="/contact" class="hover:text-slate-300">Contact</a>
        <a href="#site-header" class="inline-flex items-center gap-1 hover:text-amber-400 text-slate-400">
          Back to top ↑
        </a>
      </div>
    </div>
  </div>
</footer>
