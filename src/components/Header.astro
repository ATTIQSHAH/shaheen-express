---
import siteData from '../content/site.json';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'About Us', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Schedule', href: '/schedule' },
  { label: 'Fleet', href: '/fleet' },
  { label: 'Terminals', href: '/terminals' },
];
---

<header class="sticky top-0 z-40 w-full bg-[#0B132B]/95 backdrop-blur-md border-b border-slate-800 text-white transition-all duration-200">
  <!-- Top Utility Bar (Desktop) -->
  <div class="hidden md:block bg-[#070C1B] border-b border-slate-800/80 py-1.5 text-xs text-slate-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <div class="flex items-center space-x-6">
        <span class="flex items-center gap-1.5 text-amber-400 font-medium">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          24/7 Intercity Bus Service • Established 2014
        </span>
        <span class="flex items-center gap-1.5 text-slate-400">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
          Kohat Cantt, KPK
        </span>
      </div>
      <div class="flex items-center space-x-6">
        <a href={siteData.phone_link} class="flex items-center gap-1.5 hover:text-amber-400 transition-colors font-medium">
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
          </svg>
          Direct Booking: <strong class="text-white tracking-wide">{siteData.phone}</strong>
        </a>
        <a href={siteData.social.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors" aria-label="Shaheen Express Facebook">
          Facebook
        </a>
        <a href={siteData.social.youtube} target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors" aria-label="Shaheen Express YouTube">
          YouTube
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo + Name -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="w-12 h-12 rounded-full bg-white p-1 shadow-md ring-2 ring-amber-400/40 group-hover:ring-amber-400 transition-all flex items-center justify-center overflow-hidden">
          <img
            src="/images/logo.webp"
            alt="Shaheen Express Logo"
            width="44"
            height="44"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-extrabold tracking-tight text-white uppercase group-hover:text-amber-400 transition-colors font-['Plus_Jakarta_Sans']">
            Shaheen Express
          </span>
          <span class="text-[11px] text-slate-400 tracking-wider uppercase font-medium">
            Premier Intercity Bus Service
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all duration-150 ${
                isActive
                  ? 'bg-amber-400 text-slate-950 shadow-sm shadow-amber-400/20'
                  : 'text-slate-200 hover:text-white hover:bg-slate-800/70'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Header Actions -->
      <div class="hidden md:flex items-center space-x-3">
        <a
          href="/contact"
          class={`px-4 py-2 rounded-lg text-sm font-semibold border transition-all ${
            currentPath === '/contact'
              ? 'bg-white text-slate-950 border-white'
              : 'border-slate-700 text-white hover:bg-slate-800'
          }`}
        >
          Contact Us
        </a>
        <a
          href={siteData.phone_link}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-bold bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors shadow-md shadow-amber-500/20"
        >
          <svg class="w-4 h-4 text-slate-950" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
          </svg>
          Call to Book
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href={siteData.phone_link}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-400 text-slate-950"
          aria-label="Call Shaheen Express"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
          </svg>
          Call
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-400"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-[#0B132B] px-4 pt-3 pb-6 space-y-2">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      return (
        <a
          href={item.href}
          class={`block px-4 py-2.5 rounded-lg text-base font-semibold transition-colors ${
            isActive
              ? 'bg-amber-400 text-slate-950 font-bold'
              : 'text-slate-200 hover:bg-slate-800 hover:text-white'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <a
      href="/contact"
      class={`block px-4 py-2.5 rounded-lg text-base font-semibold transition-colors ${
        currentPath === '/contact'
          ? 'bg-amber-400 text-slate-950 font-bold'
          : 'text-slate-200 hover:bg-slate-800 hover:text-white'
      }`}
    >
      Contact Us
    </a>
    
    <div class="pt-4 mt-2 border-t border-slate-800 flex flex-col gap-2.5">
      <a
        href={siteData.phone_link}
        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-amber-400 text-slate-950 font-bold text-base shadow-lg shadow-amber-400/20"
      >
        <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
        </svg>
        Call to Book ({siteData.phone})
      </a>
      <a
        href={siteData.whatsapp_link}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base shadow-lg shadow-emerald-600/20"
      >
        Book via WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && menu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconOpen.classList.toggle('block');
      iconClose.classList.toggle('hidden');
      iconClose.classList.toggle('block');
    });
  }
</script>
