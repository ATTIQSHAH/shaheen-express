---
import routes from '../content/routes.json';
import RouteCard from './RouteCard.astro';

interface Props {
  limit?: number;
  showSearch?: boolean;
}

const { limit, showSearch = true } = Astro.props;
const displayRoutes = limit ? routes.slice(0, limit) : routes;
---

<div class="space-y-6">
  {showSearch && (
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <div class="flex items-center gap-2 text-slate-700 font-semibold text-sm">
        <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search Timetable & Cities:</span>
      </div>
      <div class="w-full sm:w-72 relative">
        <input
          type="text"
          id="routeSearchInput"
          placeholder="Filter by city, route, or number..."
          class="w-full pl-4 pr-10 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition-all"
          aria-label="Search routes schedule"
        />
        <svg class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
  )}

  <!-- Desktop Table (md and up) -->
  <div class="hidden md:block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse" id="desktopRouteTable">
        <thead>
          <tr class="bg-[#0B132B] text-white text-xs uppercase tracking-wider font-semibold border-b border-slate-800">
            <th scope="col" class="py-4 px-6">Route</th>
            <th scope="col" class="py-4 px-6">Time</th>
            <th scope="col" class="py-4 px-6">2nd Time</th>
            <th scope="col" class="py-4 px-6">Booking No</th>
            <th scope="col" class="py-4 px-6 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm font-medium text-slate-700">
          {displayRoutes.map((r) => (
            <tr class="route-table-row hover:bg-amber-50/50 transition-colors">
              <td class="py-4 px-6 font-bold text-slate-900">
                <a href={`/routes/${r.slug}`} class="hover:text-amber-600 transition-colors flex items-center gap-2">
                  <span>{r.route}</span>
                </a>
              </td>
              <td class="py-4 px-6 text-slate-900 font-semibold tabular-nums">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-slate-100 text-slate-800 text-xs font-bold">
                  {r.time}
                </span>
              </td>
              <td class="py-4 px-6 text-slate-700 tabular-nums">
                {r.second_time !== '---' ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-cyan-50 text-cyan-800 text-xs font-bold">
                    {r.second_time}
                  </span>
                ) : (
                  <span class="text-slate-400 font-normal">---</span>
                )}
              </td>
              <td class="py-4 px-6 font-mono text-xs">
                <div class="flex flex-wrap items-center gap-1.5">
                  {r.booking_numbers.map((num) => (
                    <a
                      href={`tel:${num.tel}`}
                      class="inline-flex items-center gap-1 text-slate-900 hover:text-amber-600 font-bold bg-slate-100 hover:bg-amber-100 px-2.5 py-1 rounded-lg border border-slate-200 transition-colors"
                      title={`Call ${num.display}`}
                    >
                      <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
                      </svg>
                      {num.display}
                    </a>
                  ))}
                </div>
              </td>
              <td class="py-4 px-6 text-right">
                <a
                  href={`/routes/${r.slug}`}
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-700 hover:text-slate-950 bg-slate-100 hover:bg-amber-400 transition-all"
                >
                  <span>Details</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile Cards View (under md) -->
  <div class="grid grid-cols-1 gap-4 md:hidden" id="mobileRouteCards">
    {displayRoutes.map((r) => (
      <div class="route-card-item">
        <RouteCard
          route={r.route}
          origin={r.origin}
          destination={r.destination}
          time={r.time}
          secondTime={r.second_time}
          bookingNo={r.booking_no}
          bookingNumbers={r.booking_numbers}
          slug={r.slug}
        />
      </div>
    ))}
  </div>

  <!-- No Search Results Found Message -->
  <div id="noResultsAlert" class="hidden p-8 text-center bg-white rounded-2xl border border-slate-200">
    <svg class="w-12 h-12 text-slate-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-base font-bold text-slate-800">No matching routes found</p>
    <p class="text-sm text-slate-500 mt-1">Try searching for a different destination or call our booking office directly.</p>
  </div>
</div>

<script>
  const searchInput = document.getElementById('routeSearchInput') as HTMLInputElement | null;
  const tableRows = document.querySelectorAll<HTMLTableRowElement>('.route-table-row');
  const cardItems = document.querySelectorAll<HTMLElement>('.route-card-item');
  const noResults = document.getElementById('noResultsAlert');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let matchCount = 0;

      // Filter desktop rows
      tableRows.forEach((row) => {
        const text = row.textContent?.toLowerCase() || '';
        const isMatch = text.includes(query);
        row.style.display = isMatch ? '' : 'none';
        if (isMatch) matchCount++;
      });

      // Filter mobile cards
      cardItems.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        const isMatch = text.includes(query);
        card.style.display = isMatch ? '' : 'none';
      });

      if (noResults) {
        noResults.classList.toggle('hidden', matchCount > 0);
      }
    });
  }
</script>
