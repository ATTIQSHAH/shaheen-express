---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../content/site.json';
---

<BaseLayout
  title="Contact Us | Shaheen Express"
  description="Contact Shaheen Express head office and booking support in Kohat Cantt. Phone: 0333-1583335, Email: shaheenexpress21@gmail.com, Khyber Coach Stand opp. FG Public School."
>
  <!-- Header Banner -->
  <section class="bg-[#0B132B] text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 text-amber-400 text-xs font-bold uppercase tracking-wider border border-slate-700 mb-4">
        24/7 Assistance
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight font-['Plus_Jakarta_Sans'] text-white">
        Contact Us
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mt-4 leading-relaxed">
        Get in touch with our central customer desk or locate our main terminal in Kohat Cantt.
      </p>
    </div>
  </section>

  <!-- Contact Information & Form Section -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Contact Details Cards (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-md space-y-6">
            <h2 class="text-2xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans']">
              Direct Contact Details
            </h2>

            <div class="space-y-5">
              <!-- Phone -->
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-xl bg-amber-400/20 text-amber-600 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Helpline & Bookings</span>
                  <a href={siteData.phone_link} class="text-lg font-bold text-slate-900 hover:text-amber-600 font-mono tracking-wide block">
                    {siteData.phone}
                  </a>
                  <span class="text-xs text-slate-500">Available 24/7 for passenger inquiries</span>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-xl bg-cyan-400/20 text-cyan-600 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Official Email</span>
                  <a href={`mailto:${siteData.email}`} class="text-base font-bold text-slate-900 hover:text-cyan-600 break-all block">
                    {siteData.email}
                  </a>
                  <span class="text-xs text-slate-500">Response within 24 hours</span>
                </div>
              </div>

              <!-- Address -->
              <div class="flex items-start gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="w-12 h-12 rounded-xl bg-rose-400/20 text-rose-600 flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Head Office & Stand</span>
                  <p class="text-sm font-semibold text-slate-900 leading-snug">
                    {siteData.address}
                  </p>
                </div>
              </div>
            </div>

            <!-- Social Links -->
            <div class="pt-2">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Follow Us On</span>
              <div class="flex items-center gap-3">
                <a
                  href={siteData.social.facebook}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white hover:bg-blue-600 font-bold text-xs transition-colors"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                  </svg>
                  <span>Facebook</span>
                </a>
                <a
                  href={siteData.social.youtube}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 text-white hover:bg-red-600 font-bold text-xs transition-colors"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                  <span>YouTube</span>
                </a>
              </div>
            </div>

            <!-- WhatsApp Direct CTA -->
            <div class="pt-2">
              <a
                href={siteData.whatsapp_link}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-md transition-colors"
              >
                Chat on WhatsApp Support
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Front-End Contact Form (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-md space-y-6">
          <div>
            <span class="text-xs font-bold text-amber-600 uppercase tracking-wider block">Get In Touch</span>
            <h2 class="text-2xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans'] mt-1">
              Send Us a Message
            </h2>
            <p class="text-slate-600 text-sm mt-1">
              Fill in your inquiry regarding bus departure times, sleeper reservations, or cargo shipping.
            </p>
          </div>

          <form id="contactForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="fullName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="e.g. Muhammad Ali"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
                />
              </div>

              <div>
                <label for="phoneNumber" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                  Phone Number *
                </label>
                <input
                  type="tel"
                  id="phoneNumber"
                  name="phoneNumber"
                  required
                  placeholder="e.g. 0333 1234567"
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
                />
              </div>
            </div>

            <div>
              <label for="routeInterest" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Route or Inquiry Type
              </label>
              <select
                id="routeInterest"
                name="routeInterest"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
              >
                <option value="general">General Inquiry</option>
                <option value="kohat-lahore-sleeper">Kohat to Lahore Sleeper Bus</option>
                <option value="karachi-peshawar">Karachi to Peshawar / Kohat</option>
                <option value="kohat-pindi">Kohat to Rawalpindi</option>
                <option value="kohat-abbottabad">Kohat to Abbottabad</option>
                <option value="kohat-gujranwala">Kohat to Gujranwala</option>
                <option value="bannu-hangu">Bannu / Hangu to Lahore</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Enter your question or booking request..."
                class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-amber-400/20 active:scale-95 transition-all"
            >
              Submit Inquiry
            </button>

            <!-- Success Alert -->
            <div id="formSuccessAlert" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium text-center">
              Thank you for reaching out! Your message has been received. Our team will contact you shortly.
            </div>
          </form>
        </div>

      </div>

      <!-- Google Maps Embed Section -->
      <div class="mt-16 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-md space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">Terminal Location Map</span>
            <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans']">
              Khyber Coach Stand Kohat Cantt
            </h2>
          </div>
          <span class="text-xs text-slate-500 font-medium">Opposite FG Public School, Kohat Cantt</span>
        </div>

        <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden border border-slate-200 bg-slate-100">
          <iframe
            src={siteData.google_maps_embed_url}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Shaheen Express Terminal Location Map"
          ></iframe>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
  const successAlert = document.getElementById('formSuccessAlert');

  if (contactForm && successAlert) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactForm.reset();
      successAlert.classList.remove('hidden');
      setTimeout(() => {
        successAlert.classList.add('hidden');
      }, 6000);
    });
  }
</script>
