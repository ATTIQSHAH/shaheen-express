---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteTable from '../components/RouteTable.astro';
import siteData from '../content/site.json';
---

<BaseLayout
  title="Bus Time Schedule and Routes | Shaheen Express"
  description="Check Shaheen Express bus time schedules and departure timings for routes from Kohat to Lahore, Karachi, Peshawar, Hangu, and Bannu. Call to book tickets directly."
>
  <!-- Header Banner -->
  <section class="bg-[#0B132B] text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 text-amber-400 text-xs font-bold uppercase tracking-wider border border-slate-700 mb-4">
        Official Timetable
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight font-['Plus_Jakarta_Sans'] text-white">
        Shaheen Express Bus Time Schedule and Route
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mt-4 leading-relaxed">
        Live timetable, primary & secondary departure timings, and direct contact numbers for ticket bookings.
      </p>
    </div>
  </section>

  <!-- Route Table Section -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Info notice -->
      <div class="mb-8 bg-amber-500/10 border border-amber-400/30 rounded-2xl p-4 sm:p-5 flex items-start gap-4 text-slate-800">
        <svg class="w-6 h-6 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-xs sm:text-sm">
          <p class="font-bold text-slate-900">Direct Telephone Booking Available:</p>
          <p class="text-slate-600 mt-0.5">
            Tap on any booking number in the table below to call the terminal office directly. For general inquiries, call our 24/7 central helpline at <strong>{siteData.phone}</strong>.
          </p>
        </div>
      </div>

      <!-- Searchable Route Table -->
      <RouteTable showSearch={true} />

      <!-- Terminals Cross-link Banner -->
      <div class="mt-16 bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-['Plus_Jakarta_Sans']">
            Looking for specific city terminals?
          </h2>
          <p class="text-slate-600 text-sm mt-1">
            Check terminal locations and contact numbers for Rawalpindi, Abbottabad, and Gujranwala.
          </p>
        </div>
        <a
          href="/terminals"
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#0B132B] hover:bg-slate-800 text-amber-400 font-bold text-sm transition-all shadow-md"
        >
          <span>View Terminal Directory</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
