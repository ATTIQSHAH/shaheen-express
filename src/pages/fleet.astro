---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import siteData from '../content/site.json';
---

<BaseLayout
  title="Our Luxurious Fleet & Sleeper Coaches | Shaheen Express"
  description="Explore the Shaheen Express luxury bus fleet. Featuring Yutong Master coaches, state-of-the-art sleeper berths, executive reclining cabins, and modern passenger facilities."
>
  <!-- Header Banner -->
  <section class="bg-[#0B132B] text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-800 text-amber-400 text-xs font-bold uppercase tracking-wider border border-slate-700 mb-4">
        30+ Modern Coaches
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight font-['Plus_Jakarta_Sans'] text-white">
        Our Luxurious Fleet
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mt-4 leading-relaxed">
        High-definition photography of our executive Yutong Master exterior buses, private sleeper berths, and modern seating cabins.
      </p>
    </div>
  </section>

  <!-- Photo Gallery Section with Lightbox and Tabs -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Filterable Gallery with Lightbox -->
      <Gallery showFilters={true} />

      <!-- Fleet Specifications Highlight Box -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-md">
        <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
          <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">Engineering & Comfort</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans']">
            Fleet Highlights & Onboard Standards
          </h2>
          <p class="text-slate-600 text-sm">
            Every bus in our fleet undergoes daily technical inspections and deep sanitization.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
            <div class="w-10 h-10 rounded-xl bg-amber-400/20 text-amber-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-9 6h10a2 2 0 002-2V6a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zm1 2h.01M16 19h.01" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">Yutong Master Coaches</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Modern aerodynamic chassis with electronically controlled air suspension for smooth highway journeys.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
            <div class="w-10 h-10 rounded-xl bg-cyan-400/20 text-cyan-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v11m0-4h18m0-7v11M3 10h18M7 10V7a2 2 0 012-2h6a2 2 0 012 2v3" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">Luxury Sleeper Berths</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Fully flat cushioned berths, privacy curtains, reading lights, and personal USB charging on Kohat to Lahore service.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 space-y-2">
            <div class="w-10 h-10 rounded-xl bg-emerald-400/20 text-emerald-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v18m0-9l4-4m-4 4l-4-4m4 4l4 4m-4-4l-4 4M3 12h18" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">Climate Controlled Cabins</h3>
            <p class="text-xs sm:text-sm text-slate-600">
              High-capacity air conditioning systems ensuring comfortable temperatures throughout the long intercity routes.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-slate-100 text-center">
          <a
            href={siteData.phone_link}
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-amber-400 text-slate-950 font-bold text-sm shadow-md hover:bg-amber-300 transition-colors"
          >
            <span>Book Your Seat On Our Fleet: {siteData.phone}</span>
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
